<% content_for :title, "Etapas — PipelineHQ" %>

<%= render CrudIndexComponent.new(
      title: "Etapas do funil",
      subtitle: "Como você organiza o caminho de um lead frio até virar cliente. Você define as etapas que fazem sentido pro seu negócio.",
      records: @stages,
      columns: [
        { label: "Ordem", value: ->(s) { s.position || "—" } },
        { label: "Nome",  value: ->(s) { s.name } },
        { label: "Cor",   value: ->(s) do
            if s.color.present?
              content_tag(:div, class: "inline-flex items-center gap-2") do
                content_tag(:span, "", class: "inline-block size-4 rounded-full border border-zinc-200 dark:border-zinc-800", style: "background-color: #{s.color}") +
                content_tag(:span, s.color, class: "font-mono text-xs text-zinc-600 dark:text-zinc-400")
              end
            else
              "—"
            end
          end
        }
      ],
      new_path: new_stage_path,
      new_label: "Nova etapa",
      show_path: ->(s) { stage_path(s) },
      edit_path: ->(s) { edit_stage_path(s) },
      delete_confirm: "Apagar esta etapa?",
      empty_icon: :columns,
      empty_title: "Crie as etapas do seu funil",
      empty_description: "Sugestões pra começar: Prospect → Conversa inicial → Demo agendada → Proposta enviada → Negociação → Fechado.",
      empty_action_label: "Criar primeira etapa"
    ) %>
