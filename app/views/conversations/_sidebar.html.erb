<aside class="flex w-full shrink-0 flex-col border-r border-zinc-200 bg-white md:w-80 dark:border-zinc-800 dark:bg-zinc-950"
       data-conversation-pane-target="sidebar"
       aria-label="Lista de conversas">
  <div class="border-b border-zinc-200 p-4 dark:border-zinc-800">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Mensagens</h2>
      <%= link_to new_conversation_path,
            class: "inline-flex size-7 items-center justify-center rounded-full bg-indigo-600 text-white transition hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500",
            aria: { label: "Nova conversa" } do %>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"/>
        </svg>
      <% end %>
    </div>

    <%= form_with url: conversations_path,
          method: :get,
          local: false,
          html: { role: "search", class: "mt-3 relative" },
          data: {
            controller: "search-form",
            action: "input->search-form#debounce",
            turbo_frame: "conversations_list"
          } do |form| %>
      <svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-zinc-400"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <%= form.search_field :q,
            value: search_query,
            placeholder: "Buscar conversa…",
            autocomplete: "off",
            aria: { label: "Buscar conversa" },
            class: "w-full rounded-lg border border-zinc-200 bg-zinc-50 py-1.5 pl-8 pr-3 text-sm text-zinc-900 placeholder-zinc-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder-zinc-500" %>
    <% end %>
  </div>

  <nav class="flex-1 overflow-y-auto" aria-label="Conversas">
    <%= turbo_frame_tag "conversations_list" do %>
      <% if conversations.empty? %>
        <div class="p-6 text-center text-sm text-zinc-500 dark:text-zinc-400">
          Nenhuma conversa encontrada.
        </div>
      <% else %>
        <ul role="list" data-controller="active-link">
          <%= render "conversations/page_items",
                conversations: conversations,
                current_user: current_user,
                active_id: active_id,
                search_query: search_query,
                page: page,
                has_more: has_more %>
        </ul>
      <% end %>
    <% end %>
  </nav>
</aside>
