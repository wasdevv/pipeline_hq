<% if turbo_frame_request_id == "conversations_list" %>
  <%= turbo_frame_tag "conversations_list" do %>
    <% if @conversations.empty? %>
      <div class="p-6 text-center text-sm text-zinc-500 dark:text-zinc-400">
        Nenhuma conversa encontrada.
      </div>
    <% else %>
      <ul role="list" data-controller="active-link">
        <%= render "conversations/page_items",
              conversations: @conversations,
              current_user: current_user,
              active_id: nil,
              search_query: @search_query,
              page: @page,
              has_more: @has_more %>
      </ul>
    <% end %>
  <% end %>
<% else %>
  <% content_for :title, "Mensagens — PipelineHQ" %>

  <div class="flex h-[calc(100vh-3.5rem)] overflow-hidden">
    <%= render "conversations/sidebar",
          conversations: @conversations,
          current_user: current_user,
          active_id: nil,
          search_query: @search_query,
          page: @page,
          has_more: @has_more %>

    <%= turbo_frame_tag "conversation_thread", class: "flex flex-1 items-center justify-center bg-zinc-50 dark:bg-zinc-900/50" do %>
      <%= render EmptyStateComponent.new(
            icon: :chat,
            title: "Selecione uma conversa",
            description: "Escolha uma conversa na lista ao lado ou inicie uma nova com um colega do workspace.",
            action_label: "Nova conversa",
            action_path: new_conversation_path
          ) %>
    <% end %>
  </div>
<% end %>
