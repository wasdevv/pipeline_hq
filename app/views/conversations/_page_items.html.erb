<%= render ConversationListComponent.new(
      conversations: conversations,
      current_user: current_user,
      active_id: active_id
    ) %>

<% if has_more %>
  <li id="conversations_sentinel"
      class="block px-4 py-3 text-center text-xs text-zinc-400 dark:text-zinc-500"
      data-controller="infinite-scroll"
      data-infinite-scroll-url-value="<%= conversations_path(q: search_query, page: page + 1) %>">
    Carregando mais…
  </li>
<% end %>
