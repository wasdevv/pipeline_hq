<% content_for :title, "Contatos — PipelineHQ" %>

<%= render CrudIndexComponent.new(
      title: "Contatos",
      subtitle: "Pessoas dentro das empresas. Com quem você fala pra fechar negócio.",
      records: @contacts,
      columns: [
        { label: "Nome",    value: ->(c) { c.name } },
        { label: "Empresa", value: ->(c) { c.account&.name || "—" } },
        { label: "Email",   value: ->(c) { c.email.present? ? mail_to(c.email, c.email, class: "text-indigo-600 hover:underline dark:text-indigo-400") : "—" } },
        { label: "Cargo",   value: ->(c) { c.role.presence || "—" } }
      ],
      new_path: new_contact_path,
      new_label: "Novo contato",
      show_path: ->(c) { contact_path(c) },
      edit_path: ->(c) { edit_contact_path(c) },
      delete_confirm: "Apagar este contato?",
      empty_icon: :users,
      empty_title: "Nenhum contato ainda",
      empty_description: "Sem contato não tem com quem falar. Cadastre as pessoas das empresas pra começar a anotar conversas e propostas.",
      empty_action_label: "Cadastrar primeiro contato"
    ) %>
