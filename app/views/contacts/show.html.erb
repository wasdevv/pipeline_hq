<% content_for :title, "#{@contact.name} — PipelineHQ" %>

<div class="mx-auto max-w-3xl space-y-6 p-6">
  <%= render PageHeaderComponent.new(
        title: @contact.name,
        subtitle: @contact.account&.name || "Sem empresa vinculada."
      ) %>

  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
    <dl class="divide-y divide-zinc-200 text-sm dark:divide-zinc-800">
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Nome</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @contact.name %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Empresa</dt>
        <dd class="col-span-2">
          <% if @contact.account %>
            <%= link_to @contact.account.name, account_path(@contact.account), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Email</dt>
        <dd class="col-span-2">
          <% if @contact.email.present? %>
            <%= mail_to @contact.email, @contact.email, class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Telefone</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @contact.phone.presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Cargo</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @contact.role.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Voltar", contacts_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= link_to "Editar contato", edit_contact_path(@contact), class: "rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800" %>
    <%= button_to "Apagar contato", @contact, method: :delete, form: { data: { turbo_confirm: "Apagar este contato?" } }, class: "rounded-md border border-rose-300 px-4 py-2 text-sm font-medium text-rose-700 shadow-sm transition hover:bg-rose-50 dark:border-rose-900 dark:text-rose-300 dark:hover:bg-rose-950/30" %>
  </div>
</div>
