<%= form_with(model: contact, class: "space-y-5") do |form| %>
  <% if contact.errors.any? %>
    <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-900 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-100">
      <p class="font-medium"><%= pluralize(contact.errors.count, "erro") %> impediram salvar:</p>
      <ul class="mt-1 list-disc pl-5">
        <% contact.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :account_id, "Empresa", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.collection_select :account_id, current_workspace.accounts.order(:name), :id, :name, { prompt: "Selecione uma empresa" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">A empresa onde essa pessoa trabalha.</p>
  </div>

  <%= render FormFieldComponent.new(form: form, name: :name, label: "Nome completo", type: :text, required: true) %>
  <%= render FormFieldComponent.new(form: form, name: :email, label: "Email", type: :email) %>
  <%= render FormFieldComponent.new(form: form, name: :phone, label: "Telefone", type: :text, hint: "Ex.: +55 11 99999-9999") %>
  <%= render FormFieldComponent.new(form: form, name: :role, label: "Cargo", type: :text, hint: "Ex.: Diretor de Vendas, Head of Marketing.") %>

  <div class="flex items-center justify-end gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800">
    <%= link_to "Cancelar", contacts_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= form.submit (contact.persisted? ? "Salvar alterações" : "Cadastrar contato"), class: ButtonPrimaryComponent::CLASSES + " sm:w-auto" %>
  </div>
<% end %>
