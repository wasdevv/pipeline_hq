<% content_for :title, "#{t('dashboard_preferences.title')} — PipelineHQ" %>

<div class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
    <header class="mb-6">
      <h1 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
        <%= t("dashboard_preferences.title") %>
      </h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
        <%= t("dashboard_preferences.subtitle") %>
      </p>
    </header>

    <%= form_with url: dashboard_preferences_path, method: :patch, local: true, class: "space-y-4" do |form| %>
      <ul role="list" class="divide-y divide-zinc-100 dark:divide-zinc-800">
        <% @sections.each_with_index do |section, idx| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <%= label_tag "sections_#{idx}_enabled",
                  t("dashboard_preferences.sections.#{section[:section]}"),
                  class: "flex-1 text-sm font-medium text-zinc-900 dark:text-zinc-100 cursor-pointer" %>
            <input type="hidden" name="sections[<%= idx %>][section]" value="<%= section[:section] %>">
            <input type="hidden" name="sections[<%= idx %>][position]" value="<%= section[:position] %>">
            <input type="hidden" name="sections[<%= idx %>][enabled]" value="0">
            <label class="relative inline-flex h-6 w-11 cursor-pointer items-center">
              <input id="sections_<%= idx %>_enabled"
                     type="checkbox"
                     name="sections[<%= idx %>][enabled]"
                     value="1"
                     <%= "checked" if section[:enabled] %>
                     class="peer sr-only">
              <span class="h-6 w-11 rounded-full bg-zinc-200 transition peer-checked:bg-indigo-600 dark:bg-zinc-700"></span>
              <span class="absolute left-0.5 size-5 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
            </label>
          </li>
        <% end %>
      </ul>

      <div class="flex items-center justify-end gap-2 border-t border-zinc-100 pt-4 dark:border-zinc-800">
        <%= link_to t("dashboard_preferences.cancel"), root_path,
              class: "rounded-md px-3 py-2 text-sm font-medium text-zinc-600 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
        <%= form.submit t("dashboard_preferences.save"),
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>
