<% content_for :title, "#{@deal.title} — PipelineHQ" %>

<div class="mx-auto max-w-3xl space-y-6 p-6">
  <%= render PageHeaderComponent.new(
        title: @deal.title,
        subtitle: @deal.account&.name || "Sem empresa vinculada."
      ) %>

  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
    <dl class="divide-y divide-zinc-200 text-sm dark:divide-zinc-800">
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Título</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @deal.title %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Empresa</dt>
        <dd class="col-span-2">
          <% if @deal.account %>
            <%= link_to @deal.account.name, account_path(@deal.account), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Contato</dt>
        <dd class="col-span-2">
          <% if @deal.contact %>
            <%= link_to @deal.contact.name, contact_path(@deal.contact), class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Etapa</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @deal.stage&.name || "—" %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Valor</dt>
        <dd class="col-span-2 font-mono text-zinc-900 dark:text-zinc-100">
          <% if @deal.amount_cents.present? %>
            <%= Money.new(@deal.amount_cents, @deal.currency || "BRL").format %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Fechamento esperado</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100">
          <% if @deal.expected_close_on.present? %>
            <%= l(@deal.expected_close_on, format: :long) %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Status</dt>
        <dd class="col-span-2">
          <% if @deal.status.present? %>
            <span class="inline-flex rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
              <%= translate_enum(:deal, :status, @deal.status) %>
            </span>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Voltar", deals_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= link_to "Editar negócio", edit_deal_path(@deal), class: "rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800" %>
    <%= button_to "Apagar negócio", @deal, method: :delete, form: { data: { turbo_confirm: "Apagar este negócio?" } }, class: "rounded-md border border-rose-300 px-4 py-2 text-sm font-medium text-rose-700 shadow-sm transition hover:bg-rose-50 dark:border-rose-900 dark:text-rose-300 dark:hover:bg-rose-950/30" %>
  </div>
</div>
