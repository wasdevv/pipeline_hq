<% content_for :title, "Negócios — PipelineHQ" %>

<%= render CrudIndexComponent.new(
      title: "Negócios",
      subtitle: "Suas negociações em andamento e fechadas. Onde mora o dinheiro do funil.",
      records: @deals,
      columns: [
        { label: "Negócio", value: ->(d) { d.title } },
        { label: "Empresa", value: ->(d) { d.account&.name || "—" } },
        { label: "Estágio", value: ->(d) { d.stage&.name || "—" } },
        { label: "Valor",   value: ->(d) { d.amount_cents.present? ? Money.new(d.amount_cents, d.currency || "BRL").format : "—" }, align: :right },
        { label: "Status",  value: ->(d) { d.status.present? ? content_tag(:span, d.status, class: "inline-flex rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300") : "" } }
      ],
      new_path: new_deal_path,
      new_label: "Novo negócio",
      show_path: ->(d) { deal_path(d) },
      edit_path: ->(d) { edit_deal_path(d) },
      delete_confirm: "Apagar este negócio?",
      empty_icon: :briefcase,
      empty_title: "Nenhum negócio ainda",
      empty_description: "Negócio é a unidade básica do seu trabalho. Cada conversa com cliente pode virar um negócio aqui — assim você não esquece nem perde o follow-up.",
      empty_action_label: "Registrar primeiro negócio"
    ) %>
