<%= form_with(model: deal, class: "space-y-5") do |form| %>
  <% if deal.errors.any? %>
    <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-900 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-100">
      <p class="font-medium"><%= pluralize(deal.errors.count, "erro") %> impediram salvar:</p>
      <ul class="mt-1 list-disc pl-5">
        <% deal.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render FormFieldComponent.new(form: form, name: :title, label: "Título do negócio", type: :text, required: true, hint: "Ex.: SaaS de RH — Empresa XYZ (50 funcionários).") %>

  <div>
    <%= form.label :account_id, "Empresa", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.collection_select :account_id, current_workspace.accounts.order(:name), :id, :name, { prompt: "Selecione uma empresa" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
  </div>

  <div>
    <%= form.label :contact_id, "Contato principal", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.collection_select :contact_id, current_workspace.contacts.order(:name), :id, :name, { prompt: "Selecione um contato" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
  </div>

  <div>
    <%= form.label :stage_id, "Etapa do funil", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.collection_select :stage_id, current_workspace.stages.order(:position), :id, :name, { prompt: "Selecione uma etapa" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= render FormFieldComponent.new(form: form, name: :amount_cents, label: "Valor (em centavos)", type: :number, hint: "Ex.: 500000 = R$ 5.000,00") %>
    <%= render FormFieldComponent.new(form: form, name: :currency, label: "Moeda", type: :text, hint: "Ex.: BRL, USD.") %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= render FormFieldComponent.new(form: form, name: :expected_close_on, label: "Fechamento esperado", type: :date) %>

    <div>
      <%= form.label :status, "Status", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
      <%= form.select :status, options_for_select(enum_options_for(:deal, :status, %w[open won lost]), deal.status), { prompt: "Selecione" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800">
    <%= link_to "Cancelar", deals_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= form.submit (deal.persisted? ? "Salvar alterações" : "Cadastrar negócio"), class: ButtonPrimaryComponent::CLASSES + " sm:w-auto" %>
  </div>
<% end %>
