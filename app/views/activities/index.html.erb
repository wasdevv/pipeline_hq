<% content_for :title, "Atividades — PipelineHQ" %>

<%= render CrudIndexComponent.new(
      title: "Atividades",
      subtitle: "Cada call, email, reunião ou nota fica registrado aqui. É o histórico do que aconteceu em cada negócio.",
      records: @activities,
      columns: [
        { label: "Tipo",    value: ->(a) { a.kind.present? ? content_tag(:span, a.kind, class: "inline-flex rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300") : "" } },
        { label: "Assunto", value: ->(a) { a.subject.presence || "—" } },
        { label: "Negócio", value: ->(a) { a.deal&.title || "—" } },
        { label: "Quando",  value: ->(a) { a.occurred_at.present? ? l(a.occurred_at, format: :short) : "—" } }
      ],
      new_path: new_activity_path,
      new_label: "Nova atividade",
      show_path: ->(a) { activity_path(a) },
      edit_path: ->(a) { edit_activity_path(a) },
      delete_confirm: "Apagar esta atividade?",
      empty_icon: :activity,
      empty_title: "Nenhuma atividade ainda",
      empty_description: "Toda vez que você fala com um cliente, anote aqui. A atividade fica colada num negócio — você não vai mais esquecer o que combinou.",
      empty_action_label: "Registrar primeira atividade"
    ) %>
