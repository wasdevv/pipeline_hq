<%= form_with(model: activity, class: "space-y-5") do |form| %>
  <% if activity.errors.any? %>
    <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-900 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-100">
      <p class="font-medium"><%= pluralize(activity.errors.count, "erro") %> impediram salvar:</p>
      <ul class="mt-1 list-disc pl-5">
        <% activity.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :deal_id, "Negócio relacionado", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.collection_select :deal_id, current_workspace.deals.order(:title), :id, :title, { prompt: "Selecione um negócio" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
  </div>

  <div>
    <%= form.label :kind, "Tipo de atividade", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.select :kind, options_for_select([ [ "Ligação", "call" ], [ "Email", "email" ], [ "Reunião", "meeting" ], [ "Nota", "note" ], [ "Tarefa", "task" ] ], activity.kind), { prompt: "Selecione" }, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
  </div>

  <%= render FormFieldComponent.new(form: form, name: :subject, label: "Assunto", type: :text, required: true, hint: "Resumo curto do que aconteceu.") %>

  <div>
    <%= form.label :body, "Detalhes", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.textarea :body, rows: 4, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm placeholder:text-zinc-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900" %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Anote o que foi conversado, decidido ou combinado.</p>
  </div>

  <%= render FormFieldComponent.new(form: form, name: :occurred_at, label: "Quando aconteceu", type: :datetime_local) %>

  <div class="flex items-center justify-end gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800">
    <%= link_to "Cancelar", activities_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= form.submit (activity.persisted? ? "Salvar alterações" : "Registrar atividade"), class: ButtonPrimaryComponent::CLASSES + " sm:w-auto" %>
  </div>
<% end %>
