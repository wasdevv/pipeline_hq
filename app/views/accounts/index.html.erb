<% content_for :title, "Empresas — PipelineHQ" %>

<%= render CrudIndexComponent.new(
      title: "Empresas",
      subtitle: "Empresas que você vende ou já vendeu pra elas.",
      records: @accounts,
      columns: [
        { label: "Nome",  value: ->(a) { a.name } },
        { label: "Setor", value: ->(a) { a.industry.presence || "—" } },
        { label: "Site",  value: ->(a) { a.website.present? ? link_to(a.website, a.website, target: "_blank", rel: "noopener", class: "text-indigo-600 hover:underline dark:text-indigo-400") : "—" } }
      ],
      new_path: new_account_path,
      new_label: "Nova empresa",
      show_path: ->(a) { account_path(a) },
      edit_path: ->(a) { edit_account_path(a) },
      delete_confirm: "Apagar esta empresa?",
      empty_icon: :building,
      empty_title: "Nenhuma empresa ainda",
      empty_description: "Cadastre as empresas pra quem você vende. A primeira empresa é o começo do seu funil.",
      empty_action_label: "Cadastrar primeira empresa"
    ) %>
