<%= form_with(model: account, class: "space-y-5") do |form| %>
  <% if account.errors.any? %>
    <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-900 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-100">
      <p class="font-medium"><%= pluralize(account.errors.count, "erro") %> impediram salvar:</p>
      <ul class="mt-1 list-disc pl-5">
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render FormFieldComponent.new(form: form, name: :name, label: "Nome", type: :text, required: true) %>
  <%= render FormFieldComponent.new(form: form, name: :industry, label: "Setor", type: :text, hint: "Ex.: SaaS, Varejo, Educação.") %>
  <%= render FormFieldComponent.new(form: form, name: :website, label: "Site", type: :text, hint: "Ex.: https://acme.com.br") %>

  <div>
    <%= form.label :notes, "Anotações", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
    <%= form.textarea :notes, rows: 4, class: "mt-1 w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-sm shadow-sm placeholder:text-zinc-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 dark:border-zinc-700 dark:bg-zinc-900" %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Detalhes que você quer lembrar sobre essa empresa.</p>
  </div>

  <div class="flex items-center justify-end gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800">
    <%= link_to "Cancelar", accounts_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= form.submit (account.persisted? ? "Salvar alterações" : "Cadastrar empresa"), class: ButtonPrimaryComponent::CLASSES + " sm:w-auto" %>
  </div>
<% end %>
