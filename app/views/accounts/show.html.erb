<% content_for :title, "#{@account.name} — PipelineHQ" %>

<div class="mx-auto max-w-3xl space-y-6 p-6">
  <%= render PageHeaderComponent.new(
        title: @account.name,
        subtitle: @account.industry.presence || "Sem setor definido."
      ) %>

  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
    <dl class="divide-y divide-zinc-200 text-sm dark:divide-zinc-800">
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Nome</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @account.name %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Setor</dt>
        <dd class="col-span-2 text-zinc-900 dark:text-zinc-100"><%= @account.industry.presence || "—" %></dd>
      </div>
      <div class="grid grid-cols-3 gap-4 px-6 py-4">
        <dt class="font-medium text-zinc-500 dark:text-zinc-400">Site</dt>
        <dd class="col-span-2">
          <% if @account.website.present? %>
            <%= link_to @account.website, @account.website, target: "_blank", rel: "noopener", class: "text-indigo-600 hover:underline dark:text-indigo-400" %>
          <% else %>
            <span class="text-zinc-400">—</span>
          <% end %>
        </dd>
      </div>
      <% if @account.notes.present? %>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
          <dt class="font-medium text-zinc-500 dark:text-zinc-400">Anotações</dt>
          <dd class="col-span-2 whitespace-pre-line text-zinc-700 dark:text-zinc-300"><%= @account.notes %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Voltar", accounts_path, class: "rounded-md px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <%= link_to "Editar empresa", edit_account_path(@account), class: "rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800" %>
    <%= button_to "Apagar empresa", @account, method: :delete, form: { data: { turbo_confirm: "Apagar esta empresa? Os contatos e negócios vinculados também serão removidos." } }, class: "rounded-md border border-rose-300 px-4 py-2 text-sm font-medium text-rose-700 shadow-sm transition hover:bg-rose-50 dark:border-rose-900 dark:text-rose-300 dark:hover:bg-rose-950/30" %>
  </div>
</div>
