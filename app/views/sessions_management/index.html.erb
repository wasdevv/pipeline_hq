<% content_for :title, "Sessões ativas — PipelineHQ" %>

<div class="mx-auto max-w-3xl space-y-6 p-6">
  <%= render PageHeaderComponent.new(
        title: "Sessões ativas",
        subtitle: "Dispositivos onde você está logado agora. Revogue qualquer um que você não reconhece."
      ) %>

  <% if @sessions.size > 1 %>
    <div class="flex justify-end">
      <%= render ButtonSecondaryComponent.new(
            label: "Revogar todas as outras",
            path: sessions_management_destroy_all_path,
            method: :delete,
            variant: :danger,
            confirm: "Revogar todas as outras sessões? Você continuará logado nesta."
          ) %>
    </div>
  <% end %>

  <ul class="divide-y divide-zinc-200 overflow-hidden rounded-xl border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
    <% @sessions.each do |s| %>
      <li class="flex items-center justify-between gap-4 p-4 transition hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30">
        <div class="min-w-0">
          <p class="truncate font-medium text-zinc-900 dark:text-zinc-100">
            <%= s.user_agent.presence || "Dispositivo desconhecido" %>
          </p>
          <p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-xs text-zinc-500 dark:text-zinc-400">
            <span class="font-mono"><%= s.ip_address %></span>
            <span>·</span>
            <span>ativo <%= time_ago_in_words(s.last_active_at || s.created_at) %> atrás</span>
            <% if s == current_session %>
              <span>·</span>
              <span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-100">
                sessão atual
              </span>
            <% end %>
          </p>
        </div>
        <% unless s == current_session %>
          <%= render ButtonSecondaryComponent.new(
                label: "Revogar",
                path: sessions_management_destroy_path(s),
                method: :delete,
                variant: :danger
              ) %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
