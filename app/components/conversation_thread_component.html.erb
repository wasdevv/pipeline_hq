<section class="flex flex-1 flex-col overflow-hidden"
         aria-label="Thread da conversa com <%= display_name %>"
         data-controller="conversation presence"
         data-presence-workspace-id-value="<%= @conversation.workspace_id %>"
         data-presence-recipient-id-value="<%= other_member&.id %>">
  <header class="flex items-center justify-between border-b border-zinc-200 bg-white px-4 py-3 sm:px-6 dark:border-zinc-800 dark:bg-zinc-950">
    <div class="flex items-center gap-3">
      <%= link_to conversations_path,
            data: { turbo_frame: "_top" },
            aria: { label: "Voltar para conversas" },
            class: "inline-flex size-9 shrink-0 items-center justify-center rounded-full text-zinc-500 hover:bg-zinc-100 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800" do %>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      <% end %>
      <span class="inline-flex size-9 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300">
        <%= initials(display_name) %>
      </span>
      <div>
        <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-100"><%= display_name %></p>
        <p class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400">
          <span data-presence-target="dot"
                class="size-1.5 rounded-full <%= initial_online? ? 'bg-emerald-500' : 'bg-zinc-300 dark:bg-zinc-600' %>"
                aria-hidden="true"></span>
          <span data-presence-target="label"><%= initial_online? ? "Online" : "Offline" %></span>
        </p>
      </div>
    </div>
  </header>

  <div class="flex-1 overflow-y-auto bg-zinc-50 px-4 py-4 sm:px-6 dark:bg-zinc-900/50"
       data-conversation-target="scroll"
       aria-live="polite"
       aria-label="Mensagens">
    <%= helpers.turbo_stream_from stream_name %>

    <div id="<%= dom_id(@conversation, :messages) %>">
      <% grouped_messages.each do |day, messages| %>
        <div class="relative mb-4 flex items-center gap-3">
          <div class="flex-1 border-t border-zinc-200 dark:border-zinc-800"></div>
          <span class="shrink-0 rounded-full bg-white px-3 py-0.5 text-xs font-medium text-zinc-500 shadow-sm ring-1 ring-zinc-200 dark:bg-zinc-900 dark:text-zinc-400 dark:ring-zinc-800">
            <%= day %>
          </span>
          <div class="flex-1 border-t border-zinc-200 dark:border-zinc-800"></div>
        </div>

        <ul class="mb-6" role="list" aria-label="Mensagens de <%= day %>">
          <% messages.each do |message| %>
            <li id="<%= dom_id(message) %>">
              <%= render MessageBubbleComponent.new(message: message, viewer_id: @current_user.id) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>

  <footer class="border-t border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
    <%= form_with url: conversation_messages_path(@conversation),
                  scope: :message,
                  data: { controller: "message-form", action: "submit->message-form#submit keydown->message-form#handleKeydown" } do |form| %>
      <div class="flex items-end gap-2 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-2 focus-within:border-indigo-500 focus-within:ring-1 focus-within:ring-indigo-500 dark:border-zinc-700 dark:bg-zinc-900 dark:focus-within:border-indigo-500">
        <%= form.text_area :body,
              rows: 1,
              required: true,
              placeholder: "Escreva uma mensagem…",
              aria: { label: "Campo de mensagem" },
              data: { "message-form-target": "input" },
              class: "flex-1 resize-none bg-transparent py-1 text-base text-zinc-900 placeholder-zinc-400 focus:outline-none sm:text-sm dark:text-zinc-100 dark:placeholder-zinc-600" %>
        <%= form.button type: :submit,
              aria: { label: "Enviar mensagem" },
              class: "inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-white transition hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500" do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4 20-7z"/><path d="M22 2 11 13"/>
          </svg>
        <% end %>
      </div>
      <p class="mt-1.5 px-1 text-xs text-zinc-400 dark:text-zinc-600">
        Enter envia · Shift+Enter quebra linha
      </p>
    <% end %>
  </footer>
</section>
