<aside class="flex w-80 shrink-0 flex-col border-r border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-950"
       aria-label="Lista de conversas">
  <div class="border-b border-zinc-200 p-4 dark:border-zinc-800">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Mensagens</h2>
      <%= link_to new_conversation_path,
            class: "inline-flex size-7 items-center justify-center rounded-full bg-indigo-600 text-white transition hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500",
            aria: { label: "Nova conversa" } do %>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"/>
        </svg>
      <% end %>
    </div>
    <div class="relative mt-3">
      <svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-zinc-400"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="search"
             placeholder="Buscar conversa…"
             readonly
             aria-label="Buscar conversa (em breve)"
             class="w-full rounded-lg border border-zinc-200 bg-zinc-50 py-1.5 pl-8 pr-3 text-sm text-zinc-500 placeholder-zinc-400 focus:outline-none dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:placeholder-zinc-600">
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto" aria-label="Conversas">
    <% if @conversations.empty? %>
      <div class="p-6 text-center text-sm text-zinc-500 dark:text-zinc-400">
        Nenhuma conversa ainda.
      </div>
    <% else %>
      <ul role="list">
        <% @conversations.each do |conversation| %>
          <%
            name      = display_name(conversation)
            is_active = conversation.id == @active_id
            color     = avatar_color(name)
            unread    = unread_count_for(conversation)
            item_base = "flex items-start gap-3 px-4 py-3 transition w-full"
            item_cls  = is_active \
              ? "#{item_base} bg-zinc-100 dark:bg-zinc-800" \
              : "#{item_base} hover:bg-zinc-50 dark:hover:bg-zinc-900/60"
          %>
          <li>
            <%= link_to conversation_path(conversation),
                  class: item_cls,
                  aria: { current: is_active ? "page" : false } do %>
              <div class="relative shrink-0">
                <span class="inline-flex size-10 items-center justify-center rounded-full text-sm font-semibold <%= color[:bg] %> <%= color[:text] %>">
                  <%= initials(name) %>
                </span>
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="truncate text-sm <%= unread > 0 ? 'font-semibold text-zinc-900 dark:text-zinc-100' : 'font-medium text-zinc-700 dark:text-zinc-300' %>">
                    <%= name %>
                  </span>
                  <span class="shrink-0 text-xs text-zinc-400 dark:text-zinc-500">
                    <%= relative_time(conversation) %>
                  </span>
                </div>

                <div class="mt-0.5 flex items-center justify-between gap-2">
                  <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">
                    <%= last_message_text(conversation) %>
                  </p>
                  <% if unread > 0 %>
                    <span class="inline-flex size-4 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-[10px] font-semibold text-white dark:bg-indigo-500"
                          aria-label="<%= unread %> mensagens não lidas">
                      <%= unread %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </nav>
</aside>
