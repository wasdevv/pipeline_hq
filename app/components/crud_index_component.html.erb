<div class="mx-auto max-w-7xl space-y-6 p-6">
  <%= render PageHeaderComponent.new(
        title: @title,
        subtitle: @subtitle,
        action_label: @new_label,
        action_path: @new_path
      ) %>

  <% if @records.any? %>
    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
      <table class="min-w-full divide-y divide-zinc-200 text-sm dark:divide-zinc-800">
        <thead class="bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:bg-zinc-900/50 dark:text-zinc-400">
          <tr>
            <% @columns.each do |column| %>
              <th class="<%= col_class(column) %>"><%= column.label %></th>
            <% end %>
            <th class="px-4 py-3 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
          <% @records.each do |record| %>
            <tr class="transition hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30">
              <% @columns.each do |column| %>
                <td class="<%= col_class(column) %> text-zinc-700 dark:text-zinc-300">
                  <%= cell_value(record, column) %>
                </td>
              <% end %>
              <td class="px-4 py-3 text-right">
                <div class="inline-flex gap-1">
                  <%= link_to "Ver", @show_path.call(record), class: "rounded px-2 py-1 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
                  <%= link_to "Editar", @edit_path.call(record), class: "rounded px-2 py-1 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
                  <%= button_to @delete_label, record, method: :delete, form: { data: { turbo_confirm: @delete_confirm } }, class: "rounded px-2 py-1 text-xs font-medium text-rose-600 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950/30" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render EmptyStateComponent.new(
          icon: @empty_icon,
          title: @empty_title,
          description: @empty_description,
          action_label: @empty_action_label,
          action_path: @new_path
        ) %>
  <% end %>
</div>
