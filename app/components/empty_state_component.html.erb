<div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-zinc-50/50 px-6 py-16 text-center dark:border-zinc-800 dark:bg-zinc-900/30">
  <div class="inline-flex size-12 items-center justify-center rounded-full bg-indigo-100 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400">
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>"/>
    </svg>
  </div>

  <h3 class="mt-4 text-base font-semibold text-zinc-900 dark:text-zinc-100">
    <%= @title %>
  </h3>

  <% if @description.present? %>
    <p class="mt-1 max-w-md text-sm text-zinc-500 dark:text-zinc-400">
      <%= @description %>
    </p>
  <% end %>

  <% if @action_label.present? && @action_path.present? %>
    <%= link_to @action_path,
          class: "mt-5 inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-indigo-500" do %>
      <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 4v12M4 10h12"/>
      </svg>
      <%= @action_label %>
    <% end %>
  <% end %>
</div>
