<div class="rounded-xl border border-zinc-200 bg-white p-5 transition hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700">
  <div class="flex items-start justify-between gap-2">
    <p class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
      <%= @label %>
    </p>
    <% if @icon.present? %>
      <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full <%= accent_classes %>">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>"/>
        </svg>
      </span>
    <% end %>
  </div>

  <p class="mt-2 text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
    <%= @value %>
  </p>

  <% if @hint.present? %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
      <%= @hint %>
    </p>
  <% end %>
</div>
